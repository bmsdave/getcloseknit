# Close Knit deployment settings — copy to deploy/.env (git-ignored).
# `./init-env.sh` writes this file with generated secrets. Docker Compose reads
# it automatically from this directory; `./preflight.sh` checks it.

## Required secrets (generated by init-env.sh; never commit)
CLOSE_KNIT_DB_PASSWORD=
# Salts the hashes of e-mails, tokens and IPs behind hide-my-home requests.
# Changing it later invalidates pending confirmation links and daily counters.
CLOSE_KNIT_OBJECTION_SALT=
# Shared by the web and api containers: the web server's reads for one page render
# carry it, so the API charges the viewer one page view (rate class "render") instead
# of every read. Unset: each read is charged on its own and quick page views lose
# their server-rendered sections. On an existing server, add or rotate it with:
#   sed -i '/^CLOSE_KNIT_INTERNAL_KEY=/d' .env && echo "CLOSE_KNIT_INTERNAL_KEY=$(openssl rand -hex 32)" >> .env
CLOSE_KNIT_INTERNAL_KEY=

## Where the site lives
# Public host for TLS (docker-compose.prod.yml, Caddy) and links in e-mails.
CLOSE_KNIT_DOMAIN=areas.example.org
CLOSE_KNIT_PUBLIC_URL=https://areas.example.org
# Optional: other names that redirect to CLOSE_KNIT_DOMAIN (comma separated).
CLOSE_KNIT_REDIRECT_DOMAINS=www.areas.example.org
# Optional: the server's own name, which serves the other sites on this host
# (/srv/caddy-sites) and redirects every other path to CLOSE_KNIT_DOMAIN.
CLOSE_KNIT_SITES_HOST=
# public (default) or private: one shared login in front of the whole site
# except /api/v1/health (access-private.caddy). Private needs all three:
# the hash from `docker compose exec caddy caddy hash-password`, in single
# quotes, and the plain password for preflight.sh and ship.sh.
CLOSE_KNIT_ACCESS=public
CLOSE_KNIT_ACCESS_USER=
CLOSE_KNIT_ACCESS_HASH=''
CLOSE_KNIT_ACCESS_PASSWORD=
# Optional with private: enables counted invite links (tools/invite.sh
# create 20); browsers let in keep a 30-day cookie holding this value
# (openssl rand -hex 16). A new value revokes them all.
CLOSE_KNIT_INVITE_TOKEN=

## Who is responsible (shown on /privacy; see docs/legal/ico-registration.md)
CLOSE_KNIT_CONTROLLER=
CLOSE_KNIT_CONTACT_EMAIL=
CLOSE_KNIT_ICO_NUMBER=

## Notifications — at least one channel is needed for hide-my-home requests.
# SMTP sends the confirmation link straight to the requester (preferred).
# Gmail: HOST=smtp.gmail.com, PORT=587, USER and FROM = the Gmail address,
# PASSWORD = an app password (Google Account › Security › App passwords; needs
# 2-Step Verification), TO = the operator's mailbox. About 500 messages a day.
CLOSE_KNIT_SMTP_HOST=
CLOSE_KNIT_SMTP_PORT=587
CLOSE_KNIT_SMTP_USER=
CLOSE_KNIT_SMTP_PASSWORD=
CLOSE_KNIT_SMTP_FROM=
# Operator mailbox for correction reports (optional).
CLOSE_KNIT_SMTP_TO=
# JSON POST per report; without SMTP it also receives the confirmation link
# ({"kind":"objection-confirmation","email":…,"confirmUrl":…}) for your
# pipeline to forward.
CLOSE_KNIT_CORRECTIONS_WEBHOOK=

## Browser extension kill switch (api/area_api/extension_config.py, /api/v1/extension-config)
# JSON object portal -> inline | side-panel | off; portals left out keep their default
# (rightmove, zoopla, onthemarket, openrent inline; spareroom side-panel). Unknown keys or values
# are ignored and logged. If a portal objects, set it here and restart the api: no release needed.
# Example (single quotes keep the JSON literal): CLOSE_KNIT_EXTENSION_MODES='{"rightmove":"side-panel","zoopla":"off"}'
CLOSE_KNIT_EXTENSION_MODES=
# Features whose legal position is still open, JSON feature -> true | false (both on by default,
# owner 2026-10-19): resultsLine (the line under each search result), mapPopup (the line inside a
# portal's map popup card). Unknown keys or non-boolean values are ignored and logged.
# Example: CLOSE_KNIT_EXTENSION_FEATURES='{"mapPopup":false}'
CLOSE_KNIT_EXTENSION_FEATURES=

## Limits and tuning
# Per-client rate classes, layered windows (api/area_api/ratelimit.py); the
# values below are the defaults. Legacy CLOSE_KNIT_RATE_LIMIT and
# CLOSE_KNIT_TILE_RATE_LIMIT still set the minute window of default and bulk.
CLOSE_KNIT_RATE_DEFAULT=120/minute,2000/hour,10000/day
CLOSE_KNIT_RATE_BULK=600/minute,6000/hour
CLOSE_KNIT_RATE_HIZOOM=200/minute,600/hour,1000/day
CLOSE_KNIT_RATE_DETAIL=30/minute,300/hour,1000/day
CLOSE_KNIT_RATE_REPORT=5/minute,20/day
# Server-rendered pages per viewer (needs CLOSE_KNIT_INTERNAL_KEY).
CLOSE_KNIT_RATE_RENDER=30/minute,600/hour,3000/day
# MCP initialize per address inside an assistant range (their sessions are then keyed by session id).
CLOSE_KNIT_RATE_ASSISTANT_INIT=300/minute,3000/hour,30000/day
# Assistant egress CIDRs, comma-separated; empty = the published Claude and ChatGPT ranges, none = off.
CLOSE_KNIT_ASSISTANT_RANGES=
# Longest SQL statement the API runs before answering 503 query-timeout. 20 s holds for all of England once
# migration 115 is applied (the cold metric catalogue takes well under a second); no longer override it to 60 s.
CLOSE_KNIT_DB_STATEMENT_TIMEOUT_MS=20000
CLOSE_KNIT_BASEMAP_STYLE_URL=https://tiles.openfreemap.org/styles/positron
# linux/amd64 for the postgis image on Apple Silicon hosts; linux/arm64 where available.
CLOSE_KNIT_DATABASE_PLATFORM=linux/amd64
# Postgres memory (docker-compose.yml defaults: 2GB / 5GB). For a 12 GB host
# keep shared buffers at 2GB and set the cache hint to 6GB; for 24 GB, ~14GB.
CLOSE_KNIT_PG_SHARED_BUFFERS=2GB
CLOSE_KNIT_PG_EFFECTIVE_CACHE=6GB

# Internal analytics UI (Grafana), reached only through an SSH tunnel to 127.0.0.1:3300
# (docs/product-analytics.md). It starts with COMPOSE_PROFILES=analytics. Both passwords are
# generated by init-env.sh: the first is the Grafana "admin" login, the second the read-only
# database role close_knit_analytics (apply it with tools/grafana-role.sh).
COMPOSE_PROFILES=
CLOSE_KNIT_GRAFANA_ADMIN_PASSWORD=
CLOSE_KNIT_GRAFANA_DB_PASSWORD=

## Per-home EPC fields (floor area, energy rating, certificate facts).
# Off until the EPC licence is confirmed for publishing them per address
# (RELEASE-CHECKLIST.md › Going public). 1 serves them.
CLOSE_KNIT_EPC_PER_HOME=

## GLA LAEI air pollution (Health air row and rating, Air tile, air-no2 layer).
# On in production by owner decision 2026-10-18 (FLAGS.md); empty hides it.
CLOSE_KNIT_AIR_QUALITY=1
