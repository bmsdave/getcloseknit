      "title": "Reviews",
      "description": "Star reviews sent from /feedback or the prompt after a first action.",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "close-knit-analytics"
      },
      "gridPos": {
        "x": 0,
        "y": 1,
        "w": 4,
        "h": 4
