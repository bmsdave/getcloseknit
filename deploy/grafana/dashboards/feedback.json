    {
      "type": "stat",
      "title": "Average rating",
      "description": "Mean of 1-5 stars (CSAT). Read it with the count: a handful of reviews swing it.",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "close-knit-analytics"
      },
      "gridPos": {
        "x": 4,
        "y": 1,
        "w": 4,
        "h": 4
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "close-knit-analytics"
          },
          "editorMode": "code",
          "rawQuery": true,
          "format": "table",
          "rawSql": "SELECT round(avg(rating), 2) FROM site_feedback WHERE traffic IN ($traffic) AND $__timeFilter(created_at) AND kind = 'review'"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
