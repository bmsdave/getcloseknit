    {
      "type": "stat",
      "title": "Votes",
      "description": "Thumbs up or down on area-page cards and Find my area shortlists (a changed vote counts once).",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "close-knit-analytics"
      },
      "gridPos": {
        "x": 12,
        "y": 1,
        "w": 4,
        "h": 4
      },
      "targets": [
        {
