    },
    {
      "type": "stat",
      "title": "Rated 4-5",
      "description": "Share of reviews with 4 or 5 stars.",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "close-knit-analytics"
      },
      "gridPos": {
        "x": 8,
        "y": 1,
        "w": 4,
        "h": 4
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "close-knit-analytics"
          },
          "editorMode": "code",
          "rawQuery": true,
          "format": "table",
          "rawSql": "SELECT avg((rating >= 4)::int) FROM site_feedback WHERE traffic IN ($traffic) AND $__timeFilter(created_at) AND kind = 'review'"
        }
