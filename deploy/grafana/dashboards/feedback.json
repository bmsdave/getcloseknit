      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "close-knit-analytics"
          },
          "editorMode": "code",
          "rawQuery": true,
          "format": "table",
          "rawSql": "SELECT count(*) FROM site_feedback WHERE traffic IN ($traffic) AND $__timeFilter(created_at) AND kind = 'review'"
        }
